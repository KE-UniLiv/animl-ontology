<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:ce="http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl#"
  xmlns:ns1="http://purl.allotrope.org/ontologies/role#"
  xmlns:aml="http://www.w3id.org/animl/ontology/"
  xmlns:ns2="http://purl.allotrope.org/ontologies/process#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:ns3="http://purl.obolibrary.org/obo/"
  xmlns:ns4="http://purl.allotrope.org/ontologies/result#"
>
  <aml:document rdf:about="http://example.org/animl/example3#document">
    <rdf:type rdf:resource="http://purl.obolibrary.org/obo/IAO_0000310"/>
    <aml:anIMLVersion>1.0</aml:anIMLVersion>
    <aml:denotes>
      <aml:experiment rdf:about="http://example.org/animl/example3#experiment">
        <rdf:type rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0003735"/>
        <ce:hasMember rdf:resource="http://example.org/animl/example3#step_es_1"/>
        <ce:hasMember rdf:resource="http://example.org/animl/example3#step_es_2"/>
      </aml:experiment>
    </aml:denotes>
    <aml:hasSampleSet>
      <aml:sampleSet rdf:about="http://example.org/animl/example3#sampleset">
        <rdf:type rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000371"/>
        <ce:hasMember rdf:resource="http://example.org/animl/example3#sample_Matcha_00001"/>
      </aml:sampleSet>
    </aml:hasSampleSet>
  </aml:document>
  <aml:result rdf:about="http://example.org/animl/example3#result_es_2_1">
    <rdf:type rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0002011"/>
    <rdf:type rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000299"/>
    <rdf:type rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000043"/>
    <aml:name>External/Free Water Duplex</aml:name>
  </aml:result>
  <aml:sample rdf:about="http://example.org/animl/example3#sample_Matcha_00001">
    <rdf:type rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000508"/>
    <aml:identifier>Matcha-00001</aml:identifier>
    <aml:name>Matcha</aml:name>
  </aml:sample>
  <aml:experimentStep rdf:about="http://example.org/animl/example3#step_es_2">
    <aml:name>External/Free Water Duplex</aml:name>
    <aml:producesResult rdf:resource="http://example.org/animl/example3#result_es_2_1"/>
  </aml:experimentStep>
  <aml:result rdf:about="http://example.org/animl/example3#result_es_1_1">
    <rdf:type rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0002011"/>
    <rdf:type rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000299"/>
    <rdf:type rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000043"/>
    <aml:name>D33 Water (LO / Duplex emulsions)</aml:name>
  </aml:result>
  <aml:experimentStep rdf:about="http://example.org/animl/example3#step_es_1">
    <aml:name>D33 Water (LO / Duplex emulsions)</aml:name>
    <aml:producesResult rdf:resource="http://example.org/animl/example3#result_es_1_1"/>
  </aml:experimentStep>
</rdf:RDF>
