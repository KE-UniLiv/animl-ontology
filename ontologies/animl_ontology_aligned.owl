    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">This is a member of a set of signatures which, when linked to a signable item, causes it to be watermarked</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="N386e5f263f7a49139255ce4b6cbac9d1"/>
    <rdfs:subClassOf rdf:nodeID="N2d570ad12ad44ccaae0dc8833431054e"/>
