    <rdfs:comment xml:lang="en">This is an optional parameter which points outside of the file to the location of storage for the raw data that was later translated into a sample or experimentStep</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
    <rdfs:domain rdf:nodeID="N2bbaca8214714f75a3eb72199c761c55"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
