  <rdf:Description rdf:about="http://www.w3id.org/animl/ontology/Sample">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A sample is any item which is used, or that data regarding which is used, in an experiment in the document, they are often the subject of referencing to indicate that they are used in an experimentstep, however their set is attached to the document itself since they exist outside the context of the experiments described</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="N8b3cf8cea03f49a99c6e120fe394396d"/>
    <rdfs:subClassOf rdf:nodeID="Ne8c7e71cdbc54e3ba53f0d7877b5cdcc"/>
