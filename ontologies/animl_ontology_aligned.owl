    <dc:creator xml:lang="en">Andrew Ng</dc:creator>
    <dc:creator xml:lang="en">Ewan Johnson</dc:creator>
    <dc:creator xml:lang="en">Andrew Mitchell</dc:creator>
    <dc:creator xml:lang="en">Terry R. Payne</dc:creator>
    <dc:title xml:lang="en">The AnIML Ontology</dc:title>
    <rdfs:label xml:lang="en">The AnIML Ontology</rdfs:label>
    <dc:description xml:lang="en">The AnIML Ontology is a OWL-based model that formalises the semantics of the Analytical Information Markup Language (AnIML) and aligns it with the Allotrope Data Format to support cross-system and cross-lab interoperability.</dc:description>
    <rdfs:comment xml:lang="en">The AnIML Ontology is a OWL-based model that formalises the semantics of the Analytical Information Markup Language (AnIML) and aligns it with the Allotrope Data Format to support cross-system and cross-lab interoperability.</rdfs:comment>
    <owl:versionInfo xml:lang="en">1.1.0</owl:versionInfo>
    <dcterms:issued>2025-02-01</dcterms:issued>
    <dcterms:modified>2026-03-24</dcterms:modified>
    <vann:preferredNamespacePrefix>aml</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>http://www.w3id.org/animl/ontology/</vann:preferredNamespaceUri>
    <owl:priorVersion rdf:resource="http://www.w3id.org/animl/ontology/1.0.0/"/>
  </rdf:Description>
