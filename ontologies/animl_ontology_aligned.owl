  <rdf:Description rdf:about="http://www.w3id.org/animl/ontology/aligned/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionIRI rdf:resource="http://www.w3id.org/animl/ontology/aligned/1.1.0/"/>
