  <rdf:Description rdf:about="http://www.w3id.org/animl/ontology/SIUnit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">This is unique in the document in that it is both an enumeration class, e.i a class that  reifies the enumeration of a property of another class, and links to members of its own class to indicate its position in an ordered set. this is because it is known that its individuals must correspond to one of the limited set of Siunits, but those units can still be combined in an intractable number of ways, making direct enumeration of options impossible.</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="N4173c8db71cc49488ac773f808063102"/>
    <rdfs:subClassOf rdf:nodeID="Na9a87f1eb79548b7aa9d6e708bb135e2"/>
    <rdfs:subClassOf rdf:nodeID="Nee1a6dcc59fa4315bee3d7ea6ccae588"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3id.org/animl/ontology/Specification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">This is the generic superclass for specifications, those objects which represent components of animl-core classes which are governed by the relevant ATDD file,each specification may be a part of exactly one other object</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="Nafa1e5218e514f6db6066065c51c5bf2"/>
    <skos:narrower rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001532"/>
    <owl:equivalentClass rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000957"/>
    <owl:equivalentClass rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000064"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2002/07/owl#Thing">
    <rdfs:comment xml:lang="en">The fundamental root element for all ontologies</rdfs:comment>
  </rdf:Description>
