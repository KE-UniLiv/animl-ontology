  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3id.org/animl/ontology/Technique">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">This is a container for all the specification objects that exist in the ATDD governance component of a animl KB. conceptually it is also the broader specification for an experiment step, it is identical to its superclass of definition except in that it can be extended by extensions, and can have derive and consume relations, which express the ability of an ATDD to govern when samples are created or destroyed during experiment steps. as with their inverses, a technique may not have a derive and consume relation to the same reference specification. however unlike a reference specification, it may have multiple derive and consume relations over all.</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="N96710ff017f44072931dcc72105acced"/>
    <rdfs:subClassOf rdf:nodeID="N7e2157b10cfe43bb9eb319773fd97855"/>
    <rdfs:subClassOf rdf:nodeID="N82345d2530434b3993d6e010cb37a2fa"/>
  </rdf:Description>
