  <rdf:Description rdf:about="http://www.w3id.org/animl/ontology/Series">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A series is a data sturcture containing ordered data points, a series may contain data points of any of the three data point subclasses, but the subclass of all the datapoints in a series must be the same</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="N6449c208374143ea92b2d3deb68788a0"/>
    <rdfs:subClassOf rdf:nodeID="N2ff4cd041b1242c9abd03c1405119108"/>
