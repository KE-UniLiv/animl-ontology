# CQ-37: What is the allowed numeric range for a parameter in a technique definition?
# needs population confirmation.
PREFIX aml: <http://www.w3.org/animl/ontology/>

SELECT ?Technique ?parameter ?minValue ?maxValue
WHERE {
    ?Technique a aml:Technique .
    ?Technique aml:includes ?paramSpec .
    ?paramSpec a aml:ParameterSpecification ;
               aml:minValue ?minValue ;
               aml:maxValue ?maxValue .
    ?parameter aml:hasSpecification ?paramSpec .
}
ORDER BY ?Technique ?parameter ?minValue ?maxValue