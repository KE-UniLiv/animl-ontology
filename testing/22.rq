# CQ-22: What is the maximum number of samples allowed for a given role in a technique definition?
# not testable without shacl

PREFIX aml: <http://www.w3.org/animl/ontology/>

SELECT ?maxSamples
WHERE {
    ?technique aml:hasPart ?role .
    
    ?role a aml:Role ;
          aml:maxCardinality ?maxSamples .
}