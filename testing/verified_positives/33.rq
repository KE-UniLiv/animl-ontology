# CQ-33: What is the container type for a sample?
PREFIX aml: <http://www.w3id.org/animl/ontology/>

SELECT ?container ?containerType
WHERE {
    ?sample a aml:sample ;
            aml:isContained ?situation .
  	?situation a aml:sampleInContainer ;
         aml:isContainedBy ?container .
    ?container a aml:container ;
               aml:hasType ?containerType .
    ?containerType a aml:containerType .
}