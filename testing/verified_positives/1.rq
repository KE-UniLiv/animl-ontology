# CQ-1: Who digitally signed a specific part of the document?

PREFIX aml: <http://www.w3id.org/animl/ontology/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX bag: <http://www.ontologydesignpatterns.org/cp/owl/bag.owl#>

SELECT ?signature ?Agent
WHERE {
    # Match a Signature instance
    ?signature a aml:signature .
    # The signature references a specific item (the SignableItem)
    ?signature aml:marks ?SignedItem .
  
    ?Change aml:affects ?SignedItem .
  
    ?AuditTrailEntry aml:makesChange ?Change .
  
    ?AuditTrailEntry aml:requiresRole ?Role .
    ?Role aml:hasType ?RoleType .
    FILTER (?RoleType = aml:author)
    ?Agent bag:isClassifiedBy ?Role
}