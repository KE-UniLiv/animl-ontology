# CQ-57: What is the recommended plot scale for a series?

PREFIX aml: <http://www.w3.org/animl/ontology/>

SELECT ?plotScale
WHERE {
    ?series a aml:Series ;
            aml:hasSpecification ?specification .
            
    ?specification aml:hasPlotScale ?plotScale .
    # ?plotScale will be instances like aml:linear, aml:log
}