# CQ-5: which series are independent?
# The Technique Module explicitly depicts the aml:SeriesSpecification class having an aml:dependency property, which dictates the axis type (dependent vs independent) of the series.
PREFIX aml: <http://www.w3.org/animl/ontology/>

SELECT ?series
WHERE {
    # Check the series specification or the series instance itself
    ?series a aml:Series ;
            aml:dependency ?dependency .
    FILTER (?dependency = "independent")
}