# CQ-28: What sample roles are defined as blueprints for a technique?
# # needs population confirmation.

PREFIX aml: <http://www.w3.org/animl/ontology/>

SELECT ?role ?Technique ?Sample
WHERE {
    # Match the reference linking a specific sample
    ?Step a aml:ExperimentStep .
    {
        ?Step aml:producesResult ?Result .
        ?Infrastructure aml:includes ?ReferenceSet .
        ?ReferenceSet aml:hasMember ?reference .
    }
    UNION
    {
        ?Step aml:includesInfrastructure ?Infrastructure .
        ?Result aml:includes ?ReferenceSet .
        ?ReferenceSet aml:hasMember ?reference .
    }
    ?reference a aml:AnimlReference .
    ?Sample a aml:Sample .

    ?ReferenceSet aml:hasSpecification ?AnimlReferenceSpecification .
    ?AnimlReferenceSpecification a aml:AnimlReferenceSpecification .
    ?Technique ?role ?AnimlReferenceSpecification .
}