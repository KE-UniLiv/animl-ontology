#19 nothing may both directly follow and directly proceed anything else.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix aml: <http://www.w3id.org/animl/ontology/> .
@prefix ce: <http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl#> .
@prefix seq: <http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#> .




@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix seq: <http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#> .
@prefix aml: <http://www.w3id.org/animl/ontology/> .

aml:NoDirectFollowAndPrecedeShape
    a sh:NodeShape ;
    sh:targetSubjectsOf seq:directlyFollows ;
    sh:property [
        sh:path seq:directlyFollows ;
        sh:disjoint seq:directlyPrecedes ;
        sh:message "A node cannot both directly follow and directly precede the same node." ;
    ] .