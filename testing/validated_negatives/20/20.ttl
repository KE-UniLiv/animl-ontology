#20 infrastructure may not reference samples derived by its experiment step and result may not reference samples consumed by its experiment step
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix aml: <http://www.w3id.org/animl/ontology/> .
@prefix ce: <http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl#> .

aml:NoInfrastructureMayIncludeDerivedSamplesShape
    a sh:NodeShape ;
    sh:targetClass aml:infrastructure ;
    sh:sparql [
        sh:message "Infrastructure may not include samples derived by its ExperimentStep." ;
        sh:select """
            SELECT ?this
            WHERE {
                # Infrastructure includes a set of references
                ?this aml:includes/ce:hasMember/aml:pointsTo ?badSample .

                # ExperimentStep that includes this infrastructure
                ?step a aml:experimentStep ;
                      aml:includesInfrastructure ?this ;
                      aml:usesTechnique/aml:derives ?spec .

                # That step derives a spec which points to the same sample
                ?ref aml:hasSpecification ?spec ;
                     aml:pointsTo ?badSample .
            }
        """ ;
    ] .


aml:NoResultMayIncludeConsumedSamplesShape
    a sh:NodeShape ;
    sh:targetClass aml:experimentStep ;
    sh:sparql [
        sh:message "An ExperimentStep result may not include samples consumed by the same ExperimentStep." ;
        sh:select """
            SELECT ?this
            WHERE {
                # Samples included in this step’s result
                ?this aml:producesResult/aml:includes/ce:hasMember/aml:pointsTo ?badSample .

                # Samples consumed by this step via technique
                ?this aml:usesTechnique/aml:consumes ?spec .
                ?ref aml:hasSpecification ?spec ;
                     aml:pointsTo ?badSample .
            }
        """ ;
    ] .
