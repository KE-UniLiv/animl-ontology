@prefix aml: <http://www.w3id.org/animl/ontology/> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .

aml:ContainerTypeMustBeSimpleIfEmptyShape
    a sh:NodeShape ;
    sh:message "A container that does not contain a sample (via an aml:SampleInContainer situation) may not have any type other than aml:simple." ;
    sh:targetClass aml:Container ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:select """
            SELECT ?this WHERE {
                ?this a aml:Container .
                FILTER NOT EXISTS {
                    ?s a aml:SampleInContainer ;
                       aml:isContainedBy ?this .
                    ?sample a aml:Sample .
                    ?sample aml:isContained ?s .
                }
                ?this aml:hasType ?type .
                FILTER (?type != aml:simple)
            }
        """ ;
    ] .