@prefix aml: <http://www.w3id.org/animl/ontology/> .
@prefix seq: <http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#> .
@prefix ce: <http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix bag: <http://www.ontologydesignpatterns.org/cp/owl/bag.owl#> .

aml:seriesSpec_TempTime_001
    a aml:seriesSpecification ;
    aml:description "Temperature vs Time" ;
    aml:quantity "Temperature" ;
    aml:hasUnits aml:units_Celsius ;
    aml:hasPlotScale aml:linear ;
    aml:hasType aml:float32 ;
    aml:hasPart aml:dataPointSpec_TempTime_001 .

aml:dataPointSpec_TempTime_001
    a aml:DataPointSpecification ;
    aml:hasType aml:float32 ;
    aml:hasType aml:individualType .

aml:units_Celsius 
    a aml:units;
    aml:hasPart aml:units_Celsius .

aml:units_Celsius 
    a aml:units;
    aml:offset 273.15 ;
    aml:adjustsaml:k .


aml:units_KPH 
    a aml:units;
    aml:hasPart aml:units_Km ;
    aml:hasPart aml:units_Hour .

aml:units_Km 
    a aml:units;
    aml:factor 1000 ;
    aml:adjustsaml:m .

aml:units_Hour 
    a aml:units;
    aml:factor 3600 ;
    aml:adjustsaml:s .




aml:series_TempTime_001
    a aml:series ;
    aml:description "Temperature readings" ;
    aml:visibility true ;
    aml:hasSpecification aml:seriesSpec_TempTime_001 ;
    bag:isItemOf aml:Frog_entropy_information ;
    ce:hasMember aml:dp_TempTime_001 ;
    ce:hasMember aml:dp_TempTime_002 ;
    ce:hasMember aml:dp_TempTime_003 .



aml:dp_TempTime_001
    a aml:DataPoint ;
    aml:value "21.5"^^xsd:double ;
    aml:hasSpecification aml:dataPointSpec_TempTime_001 ;
    ce:isMemberOf aml:series_TempTime_001 ;
    seq:directlyPrecedes aml:dp_TempTime_002 .

aml:dp_TempTime_002
    a aml:DataPoint ;
    aml:value "22.0"^^xsd:double ;
    aml:hasSpecification aml:dataPointSpec_TempTime_001 ;
    ce:isMemberOf aml:series_TempTime_001 ;
    seq:directlyFollows aml:dp_TempTime_001 ;
    seq:directlyPrecedes aml:dp_TempTime_003 .

aml:dp_TempTime_003
    a aml:DataPoint ;
    aml:value "22.4"^^xsd:double ;
    aml:hasSpecification aml:dataPointSpec_TempTime_001 ;
    ce:isMemberOf aml:series_TempTime_001 ;
    seq:directlyFollows aml:dp_TempTime_002 .


aml:seriesSpec_FrogNumbers
    a aml:seriesSpecification ;
    aml:description "Frogs over time" ;
    aml:quantity "Frogs" ;
    aml:hasUnits aml:units_null ;
    aml:hasPlotScale aml:linear ;
    aml:hasType aml:int32 ;
    aml:hasPart aml:dataPointSpec_FrogNumber .

aml:dataPointSpec_FrogNumber
    a aml:DataPointSpecification ;
    aml:hasType aml:individualType .

aml:units_null
    a aml:units;
    aml:hasPart aml:units_null .

aml:units_null 
    a aml:units;
    aml:adjustsaml:1 .


aml:Frog_numbers
    a aml:series ;
    aml:description "Frog" ;
    aml:visibility true ;
    aml:hasSpecification aml:seriesSpec_FrogNumbers ;
    bag:isItemOf aml:Frog_entropy_information ;
    ce:hasMember aml:dp_FrogNumber_001 ;
    ce:hasMember aml:dp_FrogNumber_002 ;
    ce:hasMember aml:dp_FrogNumber_003 .


aml:dp_FrogNumber_001
    a aml:DataPoint ;
    aml:value "7" ;
    aml:hasSpecification aml:dataPointSpec_FrogNumber ;
    ce:isMemberOf aml:series_TempTime_001 ;
    seq:directlyPrecedes aml:dp_FrogNumber_002 .

aml:dp_FrogNumber_002
    a aml:DataPoint ;
    aml:value "11" ;
    aml:hasSpecification aml:dataPointSpec_FrogNumber;
    ce:isMemberOf aml:series_TempTime_001 ;
    seq:directlyFollows aml:dp_FrogNumber_001 ;
    seq:directlyPrecedes aml:dp_FrogNumber_003 .

aml:dp_FrogNumber_003
    a aml:DataPoint ;
    aml:value "21" ;
    aml:hasSpecification aml:dataPointSpec_FrogNumber ;
    ce:isMemberOf aml:series_TempTime_001 ;
    seq:directlyFollows aml:dp_FrogNumber_002 .

aml:seriesSpec_acceleration
    a aml:seriesSpecification ;
    aml:description "Acceleration over Time" ;
    aml:hasUnits aml:units_KPH ;
    aml:hasPlotScale aml:linear ;
    aml:hasType aml:int32 ;
    aml:hasPart aml:Acceleration_increment_spec .

aml:Acceleration_increment_spec
    a aml:DataPointSpecification ;
    aml:hasType aml:autoIncrementedType .

aml:velocity_base_spec
    a aml:DataPointSpecification ;
    aml:hasType aml:individualType .

aml:series_acceleration
    a aml:series ;
    aml:description "acceleration" ;
    aml:visibility true ;
    aml:hasSpecification aml:seriesSpec_acceleration ;
    bag:isItemOf aml:Frog_entropy_information ;
    ce:hasMember aml:initial_velocity ;
    ce:hasMember aml:increment_1_acceleration ;
    ce:hasMember aml:increment_2_acceleration .



aml:initial_velocity 
    a aml:DataPoint ;
    aml:value "21.5"^^xsd:double ;
    aml:hasSpecification aml:velocity_base_spec ;
    ce:isMemberOf aml:series_acceleration ;
    seq:directlyPrecedes aml:increment_1_acceleration .

aml:increment_1_acceleration
    a aml:DataPoint ;
    aml:value "2.1"^^xsd:double ;
    aml:hasSpecification aml:Acceleration_increment_spec ;
    ce:isMemberOf aml:series_acceleration ;
    seq:directlyFollows aml:initial_velocity  ;
    seq:directlyPrecedes aml:increment_2_acceleration .

aml:increment_2_acceleration
    a aml:DataPoint ;
    aml:value "3.6"^^xsd:double ;
    aml:hasSpecification aml:Acceleration_increment_spec ;
    ce:isMemberOf aml:series_acceleration ;
    seq:directlyFollows aml:increment_1_acceleration .

aml:Frog_entropy_information
    a aml:seriesSet ;
    bag:hasItem aml:series_TempTime_001 ;
    bag:hasItem aml:Frog_numbers ;
    bag:hasItem aml:series_acceleration .

aml:tracking_information
    a aml:seriesSet ;
    bag:hasItem aml:heights .

aml:height_spec
    a aml:seriesSpecification ;
    aml:description "height of tracked object" ;
    aml:hasUnits aml:units_meters ;
    aml:hasPlotScale aml:linear ;
    aml:hasType aml:float32 ;
    aml:hasPart aml:dataPointSpec_heights .

aml:dataPointSpec_heights
    a aml:DataPointSpecification ;
    aml:hasType aml:individualType .

aml:units_meters 
    a aml:units;
    aml:hasPart aml:units_m .

aml:units_m 
    a aml:units;
    aml:factor 1 ;
    aml:adjustsaml:m .

aml:heights
    a aml:series ;
    aml:description "acceleration" ;
    aml:visibility true ;
    aml:hasSpecification aml:height_spec ;
    bag:isItemOf aml:tracking_information ;
    ce:hasMember aml:initial_velocity ;
    ce:hasMember aml:increment_1_acceleration .

aml:height_at_time_1
    a aml:DataPoint ;
    aml:value "300.5"^^xsd:double ;
    aml:hasSpecification aml:dataPointSpec_heights ;
    ce:isMemberOf aml:heights ;
    seq:directlyPrecedes aml:height_at_time_2 .

aml:height_at_time_2
    a aml:DataPoint ;
    aml:value "297.3"^^xsd:double ;
    aml:hasSpecification aml:dataPointSpec_heights ;
    ce:isMemberOf aml:heights ;
    seq:directlyFollows aml:height_at_time_1  .


aml:frog_entropy_specification
    a aml:seriesSetSpecification ;
    aml:usesTechnique aml:data_technique_001 .

aml:tracking_specification
    a aml:seriesSetSpecification ;
    aml:usesTechnique aml:data_technique_002 .

aml:technique_Step_0001
    a aml:technique ;
    aml:includes aml:tracking_specification ;
    aml:includes aml:frog_entropy_specification .

aml:data_technique_001
    a aml:technique ;
    aml:extends aml:technique_Step_0001 ;
    aml:includes aml:seriesSpec_acceleration ;
    aml:includes aml:seriesSpec_FrogNumbers ;
    aml:includes aml:seriesSpec_TempTime_001 .

aml:data_technique_002
    a aml:technique ;
    aml:extends aml:technique_Step_0001 ;
    aml:includes aml:height_spec .

aml:seriesSpec_prime_minister
    a aml:seriesSpecification ;
    aml:description "current prime minster" ;
    aml:hasUnits aml:units_null ;
    aml:hasPlotScale aml:linear ;
    aml:hasType aml:string ;
    aml:hasPart aml:dataPointSpec_prime_minister .

aml:dataPointSpec_prime_minister
    a aml:DataPointSpecification ;
    aml:hasType aml:individualType .

aml:units_null
    a aml:units;
    aml:hasPart aml:units_null .

aml:units_null 
    a aml:units;
    aml:adjustsaml:1 .

aml:series_prime_minister
    a aml:series ;
    aml:visibility true ;
    aml:hasSpecification aml:seriesSpec_prime_minister ;
    ce:hasMember aml:dp_prime_minister_001 ;
    ce:hasMember aml:dp_prime_minister_002 ;
    ce:hasMember aml:dp_prime_minister_003 .


aml:dp_prime_minister_001
    a aml:DataPoint ;
    aml:value "lizz truss" ;
    aml:hasSpecification aml:dataPointSpec_prime_minister ;
    ce:isMemberOf aml:series_prime_minister ;
    seq:directlyPrecedes aml:dp_prime_minister_002 .

aml:dp_prime_minister_002
    a aml:DataPoint ;
    aml:value "richi sunak" ;
    aml:hasSpecification aml:dataPointSpec_prime_minister;
    ce:isMemberOf aml:series_prime_minister ;
    seq:directlyFollows aml:dp_prime_minister_001 ;
    seq:directlyPrecedes aml:dp_prime_minister_003 .

aml:dp_prime_minister_003
    a aml:DataPoint ;
    aml:value "keir starma" ;
    aml:hasSpecification aml:dataPointSpec_prime_minister ;
    ce:isMemberOf aml:series_prime_minister ;
    seq:directlyFollows aml:dp_prime_minister_002 .


aml:seriesSpec_binary
    a aml:seriesSpecification ;
    aml:description "binary strings" ;
    aml:hasUnits aml:units_null ;
    aml:hasPlotScale aml:linear ;
    aml:hasType aml:string ;
    aml:hasPart aml: .

aml:dataPointSpec_binary
    a aml:DataPointSpecification ;
    aml:hasType aml:binaryEncoded .

aml:units_null
    a aml:units;
    aml:hasPart aml:units_null .

aml:units_null 
    a aml:units;
    aml:adjustsaml:1 .

aml:series_binary
    a aml:series ;
    aml:visibility true ;
    aml:hasSpecification aml:seriesSpec_binary ;
    ce:hasMember aml:dp_binary_001 ;
    ce:hasMember aml:dp_binary_002 ;
    ce:hasMember aml:binary_003 .


aml:dp_binary_001
    a aml:DataPoint ;
    aml:value "00000000111" ;
    aml:hasSpecification aml:dataPointSpec_binary ;
    ce:isMemberOf aml:series_binary ;
    seq:directlyPrecedes aml:dp_binary_002 .

aml:dp_binary_002
    a aml:DataPoint ;
    aml:value "101010101" ;
    aml:hasSpecification aml:dataPointSpec_binary;
    ce:isMemberOf aml:series_binary ;
    seq:directlyFollows aml:dp_binary_001 ;
    seq:directlyPrecedes aml:dp_binary_003 .

aml:dp_binary_003
    a aml:DataPoint ;
    aml:value "0001110001" ;
    aml:hasSpecification aml:dataPointSpec_binary ;
    ce:isMemberOf aml:series_binary ;
    seq:directlyFollows aml:dp_binary_002 .