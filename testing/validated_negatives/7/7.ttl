# 7 a series specification may not havepart more than 1 datapoint specification unless it has exactly two; and of those datapoint specs one is of type autoincremented (with this being applied only to datapoints with no directly follows relation) and the other must be of type individual encoding.
@prefix ce: <http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl#> .
@prefix bag: <http://www.ontologydesignpatterns.org/cp/owl/bag.owl#> .
@prefix seq: <http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#> .
@prefix aml: <http://www.w3id.org/animl/ontology/> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .


aml:seriesSpecificationEncodingRuleShape
    a sh:NodeShape ;
    sh:targetClass aml:seriesSpecification ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A SeriesSpecification must not have more than two DataPointSpecifications." ;
            sh:select """
                SELECT DISTINCT ?this WHERE {
                    ?this a aml:seriesSpecification .

                    ?this aml:hasPart ?spec1 .
                    ?spec1 a aml:DataPointSpecification .

                    ?this aml:hasPart ?spec2 .
                    ?spec2 a aml:DataPointSpecification .
                    FILTER(?spec1 != ?spec2)

                    ?this aml:hasPart ?spec3 .
                    ?spec3 a aml:DataPointSpecification .
                    FILTER(?spec1 != ?spec3 && ?spec2 != ?spec3)
                }
            """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Unidirectional cycle detected in seq:directlyFollows." ;
        sh:select """
            SELECT DISTINCT ?this WHERE {
                ?this a aml:seriesSpecification .
                
                ?this aml:hasPart ?spec1 .
                ?spec1 a aml:DataPointSpecification .

                ?this aml:hasPart ?spec2 .
                ?spec2 a aml:DataPointSpecification .
                FILTER(?spec1 != ?spec2)
                
                ?spec1 aml:hasType ?t1 .
                ?spec2 aml:hasType ?t2 .
                FILTER (
                    !( ?t1 = aml:autoIncrementedType && ?t2 = aml:individualType ) &&
                    !( ?t1 = aml:individualType && ?t2 = aml:autoIncrementedType )
                )
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "fuckin the third one." ;
        sh:select """
            SELECT ?this
            WHERE {
                ?this a aml:seriesSpecification .
                ?this aml:hasPart ?spec .
                
                    # datapoint uses auto-increment encoding
                ?dp aml:hasSpecification ?spec .
                ?spec aml:hasType aml:autoIncrementedType .

                # datapoint has NO predecessor → it is the first
                FILTER NOT EXISTS {
                    ?dp seq:directlyFollows ?prev .
                }


            }
        """ ;
    ] .