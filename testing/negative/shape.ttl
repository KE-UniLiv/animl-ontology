#8 an animlreferencespecification with "required" modality may not exist unless it specifies a concrete animl reference
@prefix aml: <http://www.w3id.org/animl/ontology/> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .

aml:anIMLReferenceSpecificationRequiredMustHaveConcreteAnimlReferenceShape
    a sh:NodeShape ;
    sh:targetClass aml:anIMLReferenceSpecification ;
    sh:message "AnIMLReferenceSpecification with modality 'required' must be realized by at least one concrete AnIMLReference." ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:select """
            SELECT ?this WHERE {
                ?this a aml:anIMLReferenceSpecification ;
                      aml:modality "required" .
                FILTER NOT EXISTS {
                    ?ref a aml:anIMLReference ;
                         aml:hasSpecification ?this ;
                         aml:pointsTo ?target .
                }
            }
        """ ;
    ] .