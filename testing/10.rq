# CQ-10: Which samples were produced in an experiment step?
# needs population confirmation.

PREFIX aml: <http://www.w3.org/animl/ontology/>

SELECT ?sample
WHERE {
    ?step a aml:ExperimentStep;
          aml:producesResult ?result .
          
    ?result aml:includes ?referenceSet;
        aml:hasPart ?itemSpec  .
    ?referenceSet aml:hasMember ?reference .

    ?reference aml:pointsTo ?sample ;
        aml:hasSpecification ?AnimalReferenceSpecification  .

    ?step aml:usesTechnique ?Technique .

    ?itemSpec a aml:ItemSpecification .
    ?Technique aml:includes ?itemSpec; 
        aml:derives ?AnimalReferenceSpecification .

    ?sample a aml:Sample .
}