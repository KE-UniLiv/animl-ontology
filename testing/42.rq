# CQ-42: Is a sample with a specific role required or optional for a technique?
# In the Technique Module, blueprints (specifications) such as aml:Role carry constraints. The XML attribute modality ("required" or "optional") is mapped to the aml:modality data property.

PREFIX aml: <http://www.w3id.org/animl/ontology/>

SELECT ?Technique ?referenceSpecification ?Sample
WHERE {
    ?Technique a aml:Technique .
    ?referenceSpecification a aml:AnimlReferenceSpecification .
    ?reference aml:hasSpecification ?referenceSpecification .
    ?reference aml:pointsTo ?Sample .
    ?Sample a aml:Sample .
  	{
        ?Technique ?relation ?referenceSpecification .
        FILTER(?relation = aml:consumes)
    }
    UNION
    {
        ?Technique ?relation ?referenceSpecification .
        FILTER(?relation = aml:derives)
    }

}
ORDER BY ?Technique ?Sample ?relation 